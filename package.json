{
	"name": "translation-stats",
	"version": "2.0.0",
	"description": "The plugin adds a \"Translation Stats\" column to the plugin list screen in WordPress admin.",
	"author": "Pedro Mendonça",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"WordPress",
		"i18n",
		"l10n"
	],
	"homepage": "https://github.com/pedro-mendonca/Translation-Stats#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pedro-mendonca/Translation-Stats.git"
	},
	"bugs": {
		"url": "https://github.com/pedro-mendonca/Translation-Stats/issues"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "^5.0.5",
		"@wordpress/api-fetch": "^8.0.0",
		"@wordpress/block-editor": "^19.0.0",
		"@wordpress/blocks": "^17.0.0",
		"@wordpress/components": "^43.0.0",
		"@wordpress/element": "^10.0.0",
		"@wordpress/i18n": "^7.0.0",
		"@wordpress/scripts": "^37.0.0",
		"@wordpress/server-side-render": "^7.0.0",
		"jquery": "^3.7.1",
		"jsdom": "^26.1.0",
		"tablesorter": "^2.31.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"overrides": {
		"markdownlint-cli": "^0.50.0",
		"re2js": "~2.8.7",
		"serialize-javascript": "^7.1.3",
		"katex": "^0.18.2"
	},
	"scripts": {
		"build": "wp-scripts build --source-path=assets/src",
		"start": "wp-scripts start --source-path=assets/src",
		"test:unit": "wp-scripts test-unit-js",
		"test:unit:coverage": "wp-scripts test-unit-js --coverage",
		"test:unit:watch": "wp-scripts test-unit-js --watch",
		"format:js": "wp-scripts format assets/src/js assets/src/blocks tests/js webpack.config.js vitest.config.mjs",
		"lint:css": "wp-scripts lint-style",
		"lint:css:fix": "npm run lint:css -- --fix",
		"lint:js": "wp-scripts lint-js",
		"lint:js:fix": "npm run lint:js -- --fix",
		"lint:md:docs": "wp-scripts lint-md-docs",
		"lint:pkg-json": "wp-scripts lint-pkg-json"
	}
}
